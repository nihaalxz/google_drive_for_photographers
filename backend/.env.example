# LensVault Backend Environment Configuration
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,lensvault.example.com

# Database: Uses SQLite locally if empty, or MySQL in staging/production
# Format: mysql://user:password@localhost:3306/lensvault_db
DATABASE_URL=sqlite:///db.sqlite3

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backblaze B2 (S3-compatible API)
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=lensvault-storage
B2_KEY_ID=placeholder_key_id
B2_APPLICATION_KEY=placeholder_application_key
B2_LOCAL_FALLBACK=True

# Default Workspace Quota (10 GB in bytes = 10737418240)
DEFAULT_WORKSPACE_QUOTA_BYTES=10737418240
